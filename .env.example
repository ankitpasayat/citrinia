# Copy to .env.local (gitignored) and fill in from Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only for what writes as somebody else: the seed and drip, the upload sweep, and
# agent registration. Bypasses row-level security; never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
